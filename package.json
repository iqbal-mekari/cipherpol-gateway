{
  "name": "cipherpol-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm test",
    "stage2:import": "pnpm --filter @cipherpol/admission cli import",
    "stage2:close": "pnpm --filter @cipherpol/admission cli close",
    "verify:closure": "pnpm --filter @cipherpol/admission cli verify-closure",
    "verify:parity": "pnpm --filter @cipherpol/admission cli import --source-root \"$SOFTWARE_DEV_AGENTIC_ROOT\" --source-revision \"$SOFTWARE_DEV_AGENTIC_REVISION\" --output ../../fixtures/parity/software-dev-agentic-parity.yaml --force",
    "smoke:local": "rm -rf examples/mobile-talenta/.cipherpol examples/mobile-talenta/cipherpol.lock && cd examples/mobile-talenta && npx tsx ../../packages/resolver/src/cli.ts setup --yes --registry ../../fixtures/local-registry --claude-version 2.1.89 --capability plugins",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:advisors": "supabase db advisors"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
