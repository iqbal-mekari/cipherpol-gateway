# Trimmed self-hosted Supabase stack for ai-knowledge-base.
# Only db + rest + meta + studio + kong run — no auth/realtime/storage/
# functions/pooler, since this project never calls them.
#
# Generate secrets with:
#   openssl rand -base64 32   (POSTGRES_PASSWORD, PG_META_CRYPTO_KEY)
#   openssl rand -base64 48   (JWT_SECRET, must be >=32 chars)
# Generate ANON_KEY / SERVICE_ROLE_KEY (HS256 JWTs signed with JWT_SECRET,
# payload {"role":"anon"|"service_role","iss":"supabase","iat":...,"exp":...})
# via https://supabase.com/docs/guides/self-hosting/docker#api-keys or the
# upstream repo's `utils/generate-keys.sh` against this same JWT_SECRET.

COMPOSE_FILE=docker-compose.yml

# Postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# JWT / API keys — MUST match what your ai-knowledge-base clients use as
# SUPABASE_SERVICE_ROLE_KEY.
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRY=3600
ANON_KEY=change-me-anon-jwt
SERVICE_ROLE_KEY=change-me-service-role-jwt

# Studio dashboard basic-auth (Kong gates / with this)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me

# postgres-meta connection encryption key (>=32 chars)
PG_META_CRYPTO_KEY=change-me-32-chars-min

# PostgREST schema exposure — this project only uses `public`
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# Studio cosmetics
STUDIO_DEFAULT_ORGANIZATION=ai-knowledge-base
STUDIO_DEFAULT_PROJECT=ai-knowledge-base

# Public URL clients/Studio will use to reach Kong (via Caddy)
SUPABASE_PUBLIC_URL=https://kb.yourdomain.com

# Caddy — bare domain (no scheme) that must already point at this VPS's IP,
# and an email for Let's Encrypt expiry notices.
KB_DOMAIN=kb.yourdomain.com
KB_ACME_EMAIL=you@yourdomain.com

# Remote MCP server (packages/mcp-server/src/http-server.ts), reachable at
# https://<KB_DOMAIN>/mcp. Generate with: openssl rand -base64 32
# Every teammate's Claude Code config needs this exact value as a Bearer
# token — treat it like a password, not something to commit.
MCP_AUTH_TOKEN=change-me
# Embedding model used by the remote server when indexing/searching — must
# match whatever dimension your schema migrations were built for (384 for
# Xenova/all-MiniLM-L6-v2, per 0003_vector_only_search.sql).
KB_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
KB_EMBEDDING_DIM=384
